    {
      "parameters": {
        "jsCode": "const inputData = $input.item.json;\n\nconst userName = inputData.user_name || inputData.name || \"Test User\";\nconst feedbackMessage = inputData.feedback_message || inputData.feedback || \"This is a dummy feedback message for testing purposes.\";\nconst ticketId = inputData.ticket_id || \"DEMO-2026-999\";\nconst feedbackStatus = inputData.feedback_status || \"Received (Test)\";\nconst feedbackUrl = \"#\";\nconst supportEmail = \"support@example.com\";\nconst companyAddress = \"123 Innovation Street, Tech City\";\nconst currentYear = \"2026\";\nconst demoLogoUrl = \"https://via.placeholder.com/115x40?text=Feedback+AI\";\n\nconst htmlTemplate = `<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <meta name=\"color-scheme\" content=\"light\">\n  <title>Feedback AI | Demo</title>\n</head>\n<body style=\"margin:0;padding:0;background-color:#f3f4f6;font-family:Arial,Helvetica,sans-serif;color:#202124;\">\n  <div style=\"display:none;font-size:1px;color:#f3f4f6;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;\">\n    Your voice matters. Feedback AI demo system.\n  </div>\n  <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"background:#f3f4f6;\">\n    <tr>\n      <td align=\"center\" style=\"padding:32px 12px;\">\n        <table role=\"presentation\" width=\"600\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"width:100%;max-width:600px;background:#ffffff;border-radius:16px;overflow:hidden;\">\n          <tr>\n            <td style=\"padding:24px 30px;border-bottom:1px solid #eeeeee;\">\n              <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\">\n                <tr>\n                  <td align=\"left\" valign=\"middle\">\n                    <img src=\"${demoLogoUrl}\" alt=\"Logo\" width=\"115\" style=\"display:block;width:115px;max-width:100%;height:auto;border:0;\">\n                  </td>\n                  <td align=\"right\" valign=\"middle\">\n                    <span style=\"display:inline-block;background:#eef2ff;color:#4f46e5;padding:8px 11px;border-radius:6px;font-size:11px;font-weight:bold;letter-spacing:1px;\">\n                      DEMO ENVIRONMENT\n                    </span>\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n          <tr>\n            <td align=\"center\" style=\"padding:42px 28px 34px;background:#4f46e5;\">\n              <div style=\"font-size:12px;letter-spacing:3px;font-weight:bold;color:#c7d2fe;margin-bottom:18px;\">\n                TESTING. SIMULATION. INSIGHTS.\n              </div>\n              <h1 style=\"margin:0;color:#ffffff;font-size:32px;line-height:1.2;font-weight:800;\">\n                Feedback AI<br>System Demo.\n              </h1>\n              <p style=\"margin:18px auto 0;max-width:400px;color:#e0e7ff;font-size:15px;line-height:1.8;\">\n                This is a simulated notification from your automated feedback processing pipeline.\n              </p>\n              <table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"margin-top:26px;\">\n                <tr>\n                  <td align=\"center\" style=\"background:#ffffff;border-radius:8px;padding:13px 22px;\">\n                    <span style=\"color:#4f46e5;font-size:13px;font-weight:bold;\">\n                      POWERED BY FEEDBACK AI\n                    </span>\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding:34px 30px 20px;\">\n              <p style=\"margin:0 0 12px;color:#6b7280;font-size:13px;font-weight:bold;letter-spacing:1px;\">\n                STATUS UPDATE\n              </p>\n              <h2 style=\"margin:0 0 16px;font-size:23px;line-height:1.4;color:#171717;\">\n                Hi ${userName},\n              </h2>\n              <p style=\"margin:0 0 20px;color:#4b5563;font-size:15px;line-height:1.9;\">\n                Thank you for testing the Feedback AI platform. Your submission has been processed successfully in this sandbox environment.\n              </p>\n              <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"background:#fafafa;border:1px solid #eeeeee;border-radius:10px;\">\n                <tr>\n                  <td style=\"padding:20px;\">\n                    <p style=\"margin:0 0 14px;color:#8a8a8a;font-size:11px;font-weight:bold;letter-spacing:1.5px;\">\n                      TEST TRANSACTION\n                    </p>\n                    <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\">\n                      <tr>\n                        <td valign=\"top\">\n                          <p style=\"margin:0 0 5px;color:#777777;font-size:12px;\">Reference ID</p>\n                          <p style=\"margin:0;color:#202124;font-size:15px;font-weight:bold;\">\n                            ${ticketId}\n                          </p>\n                        </td>\n                        <td valign=\"top\" align=\"right\">\n                          <span style=\"display:inline-block;background:#eef2ff;color:#4f46e5;border-radius:20px;padding:7px 11px;font-size:11px;font-weight:bold;\">\n                            ${feedbackStatus}\n                          </span>\n                        </td>\n                      </tr>\n                    </table>\n                    <div style=\"height:1px;background:#e9e9e9;margin:18px 0;\"></div>\n                    <p style=\"margin:0 0 7px;color:#777777;font-size:12px;\">Submitted text</p>\n                    <p style=\"margin:0;color:#333333;font-size:14px;line-height:1.8;overflow-wrap:anywhere;\">\n                      ${feedbackMessage}\n                    </p>\n                  </td>\n                </tr>\n              </table>\n              <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"margin-top:22px;\">\n                <tr>\n                  <td width=\"4\" style=\"background:#4f46e5;border-radius:4px;\"></td>\n                  <td style=\"padding:15px 17px;background:#eef2ff;\">\n                    <p style=\"margin:0 0 6px;color:#4f46e5;font-size:12px;font-weight:bold;\">\n                      ✦ SYSTEM NOTE\n                    </p>\n                    <p style=\"margin:0;color:#555555;font-size:13px;line-height:1.8;\">\n                      This is an isolated test run. No real corporate infrastructure or branding is impacted.\n                    </p>\n                  </td>\n                </tr>\n              </table>\n              <table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" align=\"center\" style=\"margin:30px auto 20px;\">\n                <tr>\n                  <td align=\"center\" bgcolor=\"#4f46e5\" style=\"border-radius:8px;\">\n                    <a href=\"${feedbackUrl}\" style=\"display:inline-block;padding:15px 26px;color:#ffffff;text-decoration:none;font-size:14px;font-weight:bold;\">\n                      View Test Details &rarr;\n                    </a>\n                  </td>\n                </tr>\n              </table>\n              <p style=\"margin:0;text-align:center;color:#8a8a8a;font-size:12px;line-height:1.8;\">\n                Need help? Reach out at\n                <a href=\"mailto:${supportEmail}\" style=\"color:#4f46e5;text-decoration:none;\">\n                  ${supportEmail}\n                </a>\n              </p>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding:25px 25px;background:#191919;\">\n              <p style=\"margin:0 0 8px;text-align:center;color:#ffffff;font-size:16px;font-weight:bold;\">\n                Feedback AI <span style=\"color:#4f46e5;\"> × </span> Sandbox\n              </p>\n              <p style=\"margin:0 0 16px;text-align:center;color:#bdbdbd;font-size:12px;line-height:1.8;\">\n                Automated testing and demonstration workflow.\n              </p>\n              <div style=\"height:1px;background:#353535;margin:0 0 16px;\"></div>\n              <p style=\"margin:0;text-align:center;color:#999999;font-size:11px;line-height:1.9;\">\n                Simulated email notification for testing purposes.\n                <br>\n                &copy; ${currentYear} Feedback AI Demo. All rights reserved.\n                <br>\n                ${companyAddress}\n              </p>\n            </td>\n          </tr>\n        </table>\n        <p style=\"margin:18px 0 0;text-align:center;color:#9ca3af;font-size:11px;line-height:1.7;\">\n          Demo Environment Setup.\n        </p>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>`;\n\nreturn { json: { htmlContent: htmlTemplate } };"
      },
